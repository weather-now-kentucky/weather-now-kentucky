rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /teamMembers/{memberId} {
      allow read: if resource.data.status == "active" || resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /sponsors/{sponsorId} {
      allow read: if resource.data.status == "active" || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /sponsorPlacements/{placementId} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
